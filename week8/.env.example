# Copy to .env and fill in. Dev-only values — NOT TEE-secure (whole point of the demo build).

# 32-byte hex. Used by BOTH the indexer (A2_DEV_PROVISIONING_SEED_HEX) and seed.mjs.
# Any random 64 hex chars; keep it the same on both.
SEED_HEX=1111111111111111111111111111111111111111111111111111111111111111

# <EC2 public IP>.sslip.io  → automatic HTTPS via Caddy. Example: 13.209.1.2.sslip.io
SITE_ADDRESS=YOUR_EC2_PUBLIC_IP.sslip.io

# Mainnet lightwalletd for the A1 payment scanner.
LIGHTWALLETD_URL=https://zec.rocks:443
