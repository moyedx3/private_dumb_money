{
  "name": "drop-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "qa:http-smoke": "node scripts/http-smoke.mjs",
    "qa:lane-c": "npm test && npm run build && npm run test:browser -- --project=chromium && node scripts/check-secret-sinks.mjs && npm run qa:http-smoke"
  },
  "dependencies": {
    "@phala/dcap-qvl": "^0.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "ky": "^2.0.2",
    "libsodium-wrappers": "^0.7.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.9"
  }
}
